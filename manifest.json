{
  "manifest_version": 3,
  "name": "Archiv-Link für archive.today",
  "short_name": "Archiv-Link",
  "version": "1.1.0",
  "description": "Öffnet Seiten und Links bei archive.today – mit einem Klick direkt zur neuesten Kopie, mit Schutz vor Fremd-Code.",
  "minimum_chrome_version": "110",

  "permissions": ["activeTab", "contextMenus", "storage", "declarativeNetRequest"],

  "host_permissions": [
    "https://archive.ph/*",
    "https://archive.today/*",
    "https://archive.is/*",
    "https://archive.li/*",
    "https://archive.md/*",
    "https://archive.vn/*",
    "https://archive.fo/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Archiv-Link",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+A" }
    }
  },

  "declarative_net_request": {
    "rule_resources": [
      { "id": "schutz", "enabled": true, "path": "rules/schutz.json" }
    ]
  },

  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src https://archive.ph https://archive.today https://archive.is https://archive.li https://archive.md https://archive.vn https://archive.fo; base-uri 'none'; form-action 'none'"
  }
}
